<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>采集日志 - IntelliSign Radar</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .log-filters { display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap; }
    .log-filters input, .log-filters select { padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: #fff; }
    .log-filters input { width: 240px; }
    .log-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .log-table th { text-align: left; padding: 10px 12px; background: #f8f9fa; font-weight: 600; border-bottom: 2px solid var(--border); white-space: nowrap; }
    .log-table td { padding: 10px 12px; border-bottom: 1px solid #f1f3f4; vertical-align: top; }
    .log-table tr:hover { background: #f8f9fa; }
    .log-status { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 12px; font-weight: 600; }
    .log-status.success { background: #e6f4ea; color: #137333; }
    .log-status.error { background: #fce8e6; color: #ea4335; }
    .log-status.running { background: #e8f0fe; color: #1a73e8; }
    .log-detail { font-size: 12px; color: #5f6368; margin-top: 4px; }
    .log-error { color: #ea4335; font-size: 12px; }
    .empty-state { text-align: center; padding: 60px 20px; color: #9aa0a6; }
    .empty-state-icon { font-size: 48px; margin-bottom: 12px; }
    .empty-state-text { font-size: 16px; }
    .pagination { display: flex; gap: 8px; justify-content: center; margin-top: 20px; }
    .pagination button { padding: 6px 14px; border: 1px solid var(--border); border-radius: 6px; background: #fff; cursor: pointer; font-size: 13px; }
    .pagination button.active { background: var(--primary); color: #fff; border-color: var(--primary); }
    .pagination button:disabled { opacity: 0.4; cursor: not-allowed; }
    .export-btn { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 8px 16px; cursor: pointer; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; transition: all .15s; }
    .export-btn:hover { background: #f8f9fa; border-color: var(--primary); color: var(--primary); }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-text">IntelliSign<small>Radar</small></div></div>
    <nav class="sidebar-nav">
      <a href="/" class="nav-item">总览仪表盘</a>
      <a href="/policy" class="nav-item">政策法规</a>
      <a href="/competitor" class="nav-item">竞品动态</a>
      <a href="/partner" class="nav-item">生态伙伴</a>
      <a href="/briefs" class="nav-item">情报简报</a>
      <a href="/collect-logs" class="nav-item active">采集日志</a>
      <a href="/settings" class="nav-item">系统设置</a>
    </nav>
    <div class="sidebar-footer"><small>IntelliSign Radar v2.1</small></div>
  </aside>
  <main class="main-content">
    <header class="page-header">
      <h1>采集日志</h1>
      <div class="header-actions">
        <button class="export-btn" onclick="exportLogs()">&#128190; 导出CSV</button>
        <button class="btn btn-primary" onclick="loadCollectLogs()">&#128260; 刷新</button>
      </div>
    </header>
    <div class="log-filters">
      <input type="text" id="logSearch" placeholder="搜索任务名称..." oninput="filterLogs()">
      <select id="logStatusFilter" onchange="filterLogs()">
        <option value="">全部状态</option>
        <option value="success">成功</option>
        <option value="error">失败</option>
      </select>
    </div>
    <div class="card">
      <div class="card-body" id="logsList">
        <div class="empty-state">
          <div class="empty-state-icon">&#128203;</div>
          <div class="empty-state-text">加载中...</div>
        </div>
      </div>
    </div>
  </main>
  <script src="/js/app.js"></script>
  <script>
    let allLogs = [];

    async function loadCollectLogs() {
      const data = await api('/collect-logs');
      if (!data || !data.data) return;
      allLogs = data.data;
      renderLogs(allLogs);
    }

    function filterLogs() {
      const keyword = document.getElementById('logSearch').value.toLowerCase();
      const status = document.getElementById('logStatusFilter').value;
      let filtered = allLogs;
      if (keyword) filtered = filtered.filter(l => l.task_name.toLowerCase().includes(keyword));
      if (status) filtered = filtered.filter(l => l.status === status);
      renderLogs(filtered);
    }

    function renderLogs(logs) {
      const el = document.getElementById('logsList');
      if (logs.length === 0) {
        el.innerHTML = '<div class="empty-state"><div class="empty-state-icon">&#128203;</div><div class="empty-state-text">暂无采集日志</div></div>';
        return;
      }
      el.innerHTML = '<table class="log-table">' +
        '<tr><th>任务名称</th><th>状态</th><th>结果数</th><th>开始时间</th><th>完成时间</th><th>耗时</th><th>错误信息</th></tr>' +
        logs.map(l => {
          const started = l.started_at ? l.started_at.replace('T', ' ').slice(0, 19) : '';
          const finished = l.finished_at ? l.finished_at.replace('T', ' ').slice(0, 19) : '';
          let duration = '';
          if (l.started_at && l.finished_at) {
            const ms = new Date(l.finished_at) - new Date(l.started_at);
            duration = ms > 60000 ? (ms / 60000).toFixed(1) + '分' : (ms / 1000).toFixed(0) + '秒';
          }
          return `<tr>
            <td><strong>${l.task_name}</strong></td>
            <td><span class="log-status ${l.status}">${l.status === 'success' ? '成功' : l.status === 'error' ? '失败' : l.status}</span></td>
            <td>${l.result_count || 0}</td>
            <td>${started}</td>
            <td>${finished}</td>
            <td>${duration}</td>
            <td class="log-error">${l.error_message || ''}</td>
          </tr>`;
        }).join('') + '</table>';
    }

    function exportLogs() {
      if (!allLogs.length) { showToast('无日志可导出', 'error'); return; }
      const header = '任务名称,状态,结果数,开始时间,完成时间,错误信息\n';
      const rows = allLogs.map(l => `"${l.task_name}","${l.status}",${l.result_count || 0},"${l.started_at || ''}","${l.finished_at || ''}","${l.error_message || ''}"`).join('\n');
      const blob = new Blob(['\ufeff' + header + rows], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'collect-logs-' + new Date().toISOString().slice(0, 10) + '.csv';
      a.click();
    }

    loadCollectLogs();
  </script>
</body>
</html>
