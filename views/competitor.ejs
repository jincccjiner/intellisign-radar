<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>竞品动态 - IntelliSign Radar</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .comp-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .comp-card { border-top: 3px solid transparent; transition: var(--transition); }
    .comp-card-name { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
    .comp-card-cnt { font-size: 28px; font-weight: 800; }
    .comp-card-date { font-size: 11px; color: var(--text-lighter); margin-top: 6px; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-text">IntelliSign<small>Radar</small></div></div>
    <nav class="sidebar-nav">
      <a href="/" class="nav-item">总览仪表盘</a>
      <a href="/policy" class="nav-item">政策法规</a>
      <a href="/competitor" class="nav-item active">竞品动态</a>
      <a href="/partner" class="nav-item">生态伙伴</a>
      <a href="/briefs" class="nav-item">情报简报</a>
      <a href="/collect-logs" class="nav-item">采集日志</a>
      <a href="/settings" class="nav-item">系统设置</a>
    </nav>
    <div class="sidebar-footer"><small>IntelliSign Radar v3.0</small></div>
  </aside>
  <main class="main-content">
    <header class="page-header">
      <h1>竞品动态监控</h1>
      <div class="header-actions">
        <button class="btn btn-primary" onclick="triggerCollect('competitor')">采集竞品动态</button>
        <button class="btn btn-outline" onclick="exportCSV('competitor')">导出CSV</button>
      </div>
    </header>

    <!-- 竞品速览卡片 -->
    <div class="comp-cards" id="compCards"></div>

    <div class="filter-bar">
      <select id="filterCompetitor" onchange="loadCompetitorV2()">
        <option value="">全部竞品</option>
        <option value="E签宝">E签宝</option>
        <option value="法大大">法大大</option>
        <option value="契约锁">契约锁</option>
        <option value="腾讯电子签">腾讯电子签</option>
      </select>
      <input type="text" id="filterKeyword" placeholder="搜索标题/摘要..." onkeyup="if(event.key==='Enter')loadCompetitorV2()" style="width:240px">
      <button class="btn btn-sm" onclick="loadCompetitorV2()">搜索</button>
      <select id="sortBy" onchange="loadCompetitorV2()">
        <option value="collect">按采集时间</option>
        <option value="publish">按发布时间</option>
      </select>
      <select id="filterSeverity" onchange="loadCompetitorV2()">
        <option value="">全部信号</option>
        <option value="high">高信号</option>
        <option value="medium">中信号</option>
        <option value="info">低信号</option>
      </select>
    </div>
    <div class="card">
      <div class="card-body" id="competitorList"><p class="empty-text">加载中...</p></div>
    </div>
  </main>
  <script src="/js/app.js"></script>
  <script>
  const compColors = { 'E签宝': '#ea4335', '法大大': '#1a73e8', '契约锁': '#f9ab00', '腾讯电子签': '#34a853' };
  let compStats = {};

  async function loadCompCards() {
    const data = await api('/stats');
    if (!data || !data.competitorBreakdown) return;
    compStats = {};
    data.competitorBreakdown.forEach(c => compStats[c.competitor_name] = c.cnt);

    // 最新日期
    const latestDate = {};
    if (data.allCompetitors) {
      data.allCompetitors.forEach(c => {
        if (!latestDate[c.competitor_name] || c.publish_date > latestDate[c.competitor_name]) {
          latestDate[c.competitor_name] = c.publish_date;
        }
      });
    }

    const el = document.getElementById('compCards');
    el.innerHTML = ['E签宝','法大大','契约锁','腾讯电子签'].map(name => {
      const cnt = compStats[name] || 0;
      const color = compColors[name] || '#7b61ff';
      const date = latestDate[name] || '-';
      return `<div class="comp-card" onclick="filterByComp('${name}')" style="border-top:3px solid ${color}">
        <div class="comp-card-name" style="color:${color}">${name}</div>
        <div class="comp-card-cnt" style="color:${color}">${cnt}</div>
        <div class="comp-card-date">最新: ${date}</div>
      </div>`;
    }).join('');
  }

  function filterByComp(name) {
    document.getElementById('filterCompetitor').value = name;
    loadCompetitorV2();
  }

  async function loadCompetitorV2() {
    const name = document.getElementById('filterCompetitor')?.value || '';
    const keyword = document.getElementById('filterKeyword')?.value || '';
    const sortBy = document.getElementById('sortBy')?.value || 'collect';
    const severity = document.getElementById('filterSeverity')?.value || '';
    let url = `/competitors?pageSize=100&sortBy=${sortBy}`;
    if (name) url += `&name=${encodeURIComponent(name)}`;
    const data = await api(url);
    if (!data) return;

    let items = data.data || [];

    // 前端关键词过滤
    if (keyword) {
      const kw = keyword.toLowerCase();
      items = items.filter(i => (i.title||'').toLowerCase().includes(kw) || (i.summary||'').toLowerCase().includes(kw));
    }
    // 前端信号过滤
    if (severity) {
      items = items.filter(i => i.severity === severity);
    }

    const el = document.getElementById('competitorList');
    if (items.length > 0) {
      el.innerHTML = items.map(i => {
        const sevClass = i.severity === 'high' ? 'tag-high' : i.severity === 'medium' ? 'tag-medium' : 'tag-info';
        const sevLabel = i.severity === 'high' ? '高' : i.severity === 'medium' ? '中' : '观察';
        return `<div class="item-card">
          <div class="item-header">
            <div class="item-title">
              <span class="tag ${sevClass}">${sevLabel}</span>
              <span class="tag tag-cat">${escHtml(i.category||'')}</span>
              <span class="tag tag-source" style="background:${compColors[i.competitor_name]||'#eee'}20;color:${compColors[i.competitor_name]||'#333'}">${escHtml(i.competitor_name)}</span>
              ${escHtml(i.title)}
            </div>
            <div class="item-actions">
              <button class="icon-btn ${i.is_starred?'starred':''}" onclick="toggleStar('competitor','${i.id}',this)" title="收藏">&#9733;</button>
            </div>
          </div>
          <div class="item-meta">
            <span>${formatDate(i.publish_date)}</span>
            <span>${i.source_name || ''}</span>
          </div>
          ${i.summary ? `<div class="item-summary">${escHtml(i.summary.slice(0,200))}${i.summary.length>200?'...':''}</div>` : ''}
        </div>`;
      }).join('');
    } else {
      el.innerHTML = '<p class="empty-text">暂无数据，请点击"采集竞品动态"</p>';
    }
  }

  function escHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  async function toggleStar(type, id, btn) {
    const data = await api(`/${type === 'competitor' ? 'competitors' : 'partners'}/${id}`);
    if (!data) return;
    const newStar = data.is_starred ? 0 : 1;
    await api(`/${type === 'competitor' ? 'competitors' : 'partners'}/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ is_starred: newStar })
    });
    btn.classList.toggle('starred');
  }

  function exportCSV(type) {
    const list = document.getElementById(type === 'competitor' ? 'competitorList' : 'partnerList');
    // 从API重新获取完整数据
    const name = document.getElementById('filterCompetitor')?.value || '';
    let url = `/competitors?pageSize=999&sortBy=publish`;
    if (name) url += `&name=${encodeURIComponent(name)}`;
    api(url).then(data => {
      if (!data || !data.data) return;
      const header = '竞品名称,标题,摘要,发布日期,采集日期,分类,信号级别\n';
      const rows = data.data.map(i => 
        `"${i.competitor_name||''}","${(i.title||'').replace(/"/g,'""')}","${(i.summary||'').replace(/"/g,'""').slice(0,200)}","${i.publish_date||''}","${i.collect_date||''}","${i.category||''}","${i.severity||''}"`
      ).join('\n');
      const blob = new Blob(['\ufeff' + header + rows], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `竞品动态_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
      showToast('CSV已导出', 'success');
    });
  }

  loadCompCards();
  loadCompetitorV2();
  </script>
</body>
</html>
