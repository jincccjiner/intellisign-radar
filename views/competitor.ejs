<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>竞品动态 - IntelliSign Radar</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-text">IntelliSign<small>Radar</small></div></div>
    <nav class="sidebar-nav">
      <a href="/" class="nav-item">总览仪表盘</a>
      <a href="/policy" class="nav-item">政策法规</a>
      <a href="/competitor" class="nav-item active">竞品动态</a>
      <a href="/partner" class="nav-item">生态伙伴</a>
      <a href="/briefs" class="nav-item">情报简报</a>
      <a href="/collect-logs" class="nav-item">采集日志</a>
      <a href="/settings" class="nav-item">系统设置</a>
    </nav>
    <div class="sidebar-footer"><small>IntelliSign Radar v1.0</small></div>
  </aside>
  <main class="main-content">
    <header class="page-header">
      <h1>竞品动态监控</h1>
      <div class="header-actions">
        <button class="btn btn-primary" onclick="triggerCollect('competitor')">采集竞品动态</button>
      </div>
    </header>
    <div class="filter-bar">
      <select id="filterCompetitor" onchange="loadCompetitor()">
        <option value="">全部竞品</option>
        <option value="E签宝">E签宝</option>
        <option value="法大大">法大大</option>
        <option value="契约锁">契约锁</option>
        <option value="腾讯电子签">腾讯电子签</option>
      </select>
    </div>
    <div class="card">
      <div class="card-body" id="competitorList"><p class="empty-text">加载中...</p></div>
    </div>
  </main>
  <script src="/js/app.js"></script>
  <script>loadCompetitor();</script>
</body>
</html>
