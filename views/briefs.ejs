<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>情报简报 - IntelliSign Radar</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand"><div class="brand-text">IntelliSign<small>Radar</small></div></div>
    <nav class="sidebar-nav">
      <a href="/" class="nav-item">总览仪表盘</a>
      <a href="/policy" class="nav-item">政策法规</a>
      <a href="/competitor" class="nav-item">竞品动态</a>
      <a href="/partner" class="nav-item">生态伙伴</a>
      <a href="/briefs" class="nav-item active">情报简报</a>
      <a href="/collect-logs" class="nav-item">采集日志</a>
      <a href="/settings" class="nav-item">系统设置</a>
    </nav>
    <div class="sidebar-footer"><small>IntelliSign Radar v1.0</small></div>
  </aside>
  <main class="main-content">
    <header class="page-header">
      <h1>情报简报</h1>
      <div class="header-actions">
        <button class="btn btn-primary" onclick="generateBrief()">生成周报</button>
      </div>
    </header>
    <div class="card">
      <div class="card-body" id="briefsList"><p class="empty-text">加载中...</p></div>
    </div>
    <div class="card" style="margin-top:16px;display:none" id="briefDetail">
      <div class="card-header"><h2 id="briefDetailTitle">简报详情</h2><button class="btn btn-sm" onclick="closeBriefDetail()">关闭</button></div>
      <div class="card-body brief-content" id="briefDetailBody"></div>
    </div>
  </main>
  <script src="/js/app.js"></script>
  <script>loadBriefs();</script>
</body>
</html>
