<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IntelliSign Radar - 电子签章行业情报雷达</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* 四大统计卡片等分 */
    .stats-cards { grid-template-columns: repeat(4, 1fr); }

    /* ====== 中间区域：信号+竞品+伙伴 三等分 ====== */
    .mid-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }
    .mid-card {
      background: #fff;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 22px 24px;
      min-height: 220px;
      display: flex;
      flex-direction: column;
    }
    .mid-card h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-light);
      margin-bottom: 18px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* 信号分布 — 水平居中三个圆 */
    .signal-ring {
      display: flex;
      gap: 28px;
      justify-content: center;
      align-items: center;
      flex: 1;
    }
    .signal-ring-item { text-align: center; }
    .signal-ring-circle {
      width: 72px; height: 72px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; font-weight: 800;
      margin: 0 auto 6px;
    }
    .signal-ring-label { font-size: 12px; color: var(--text-light); font-weight: 500; }

    /* 柱状图 — 名称右对齐 */
    .bar-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
    .bar-row:last-child { margin-bottom: 0; }
    .bar-name { width: 72px; font-size: 13px; font-weight: 600; text-align: right; flex-shrink: 0; color: var(--text); }
    .bar-track { flex: 1; height: 26px; background: #f1f5f9; border-radius: 13px; overflow: hidden; }
    .bar-fill {
      height: 100%; border-radius: 13px;
      transition: width 0.8s cubic-bezier(.4,0,.2,1);
      display: flex; align-items: center; justify-content: flex-end;
      padding-right: 10px; font-size: 11px; font-weight: 700; color: #fff;
      min-width: 30px;
    }

    /* ====== 下部区域：趋势+预警 等分 ====== */
    .lower-row {
      display: grid;
      grid-template-columns: 3fr 2fr;
      gap: 20px;
      margin-bottom: 20px;
    }
    .lower-card {
      background: #fff;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 22px 24px;
    }
    .lower-card h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-light);
      margin-bottom: 16px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* 预警列表 */
    .alert-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f1f5f9; }
    .alert-item:last-child { border-bottom: none; }
    .alert-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }

    /* ====== 底部双栏：最近动态 ====== */
    .bottom-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .bottom-card {
      background: #fff;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .bottom-card-header {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #fafbfc;
    }
    .bottom-card-header h2 { font-size: 14px; font-weight: 600; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; }
    .bottom-card-body { padding: 16px 24px; }

    /* 响应式 */
    @media (max-width: 1200px) {
      .mid-row { grid-template-columns: 1fr; }
      .lower-row { grid-template-columns: 1fr; }
      .bottom-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-text">IntelliSign<small>Radar</small></div>
    </div>
    <nav class="sidebar-nav">
      <a href="/" class="nav-item active">总览仪表盘</a>
      <a href="/policy" class="nav-item">政策法规<span class="nav-badge" id="navPolicyBadge" style="display:none"></span></a>
      <a href="/competitor" class="nav-item">竞品动态<span class="nav-badge" id="navCompBadge" style="display:none"></span></a>
      <a href="/partner" class="nav-item">生态伙伴</a>
      <a href="/briefs" class="nav-item">情报简报</a>
      <a href="/collect-logs" class="nav-item">采集日志</a>
      <a href="/settings" class="nav-item">系统设置</a>
    </nav>
    <div class="sidebar-footer"><small>IntelliSign Radar v3.1</small></div>
  </aside>
  <main class="main-content">
    <header class="page-header">
      <h1>总览仪表盘</h1>
      <div class="header-actions">
        <button class="btn btn-primary" onclick="triggerCollect('all')">立即采集</button>
        <button class="btn btn-outline" onclick="generateBrief()">生成周报</button>
      </div>
    </header>

    <!-- 第一行：四大统计卡片 -->
    <section class="stats-cards">
      <div class="stat-card" onclick="location.href='/policy'">
        <div class="stat-icon policy-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div>
        <div class="stat-info"><div class="stat-number" id="policyCount">-</div><div class="stat-label">政策法规</div></div>
        <div class="stat-badge" id="policyBadge" style="display:none"></div>
      </div>
      <div class="stat-card" onclick="location.href='/competitor'">
        <div class="stat-icon comp-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10A15.3 15.3 0 0 1 12 2z"/></svg></div>
        <div class="stat-info"><div class="stat-number" id="competitorCount">-</div><div class="stat-label">竞品动态</div></div>
        <div class="stat-badge" id="compBadge" style="display:none"></div>
      </div>
      <div class="stat-card" onclick="location.href='/partner'">
        <div class="stat-icon partner-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <div class="stat-info"><div class="stat-number" id="partnerCount">-</div><div class="stat-label">生态伙伴</div></div>
        <div class="stat-badge" id="partnerBadge" style="display:none"></div>
      </div>
      <div class="stat-card" onclick="location.href='/briefs'">
        <div class="stat-icon brief-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div>
        <div class="stat-info"><div class="stat-number" id="briefCount">-</div><div class="stat-label">情报简报</div></div>
      </div>
    </section>

    <!-- 第二行：信号分布 + 竞品对比 + 伙伴对比（三等分） -->
    <div class="mid-row">
      <div class="mid-card">
        <h3>信号分布</h3>
        <div class="signal-ring">
          <div class="signal-ring-item">
            <div class="signal-ring-circle" style="background:#fef2f2;color:#dc2626" id="sigHigh">0</div>
            <div class="signal-ring-label">高危 [高]</div>
          </div>
          <div class="signal-ring-item">
            <div class="signal-ring-circle" style="background:#fffbeb;color:#d97706" id="sigMedium">0</div>
            <div class="signal-ring-label">关注 [中]</div>
          </div>
          <div class="signal-ring-item">
            <div class="signal-ring-circle" style="background:#eff6ff;color:#2563eb" id="sigInfo">0</div>
            <div class="signal-ring-label">一般 [观察]</div>
          </div>
        </div>
      </div>
      <div class="mid-card">
        <h3>竞品动态量对比</h3>
        <div id="compBarChart"></div>
      </div>
      <div class="mid-card">
        <h3>伙伴动态量对比</h3>
        <div id="partnerBarChart"></div>
      </div>
    </div>

    <!-- 第三行：趋势图 + 风险预警 -->
    <div class="lower-row">
      <div class="lower-card">
        <h3>近7天情报采集趋势</h3>
        <canvas id="trendCanvas" height="180"></canvas>
      </div>
      <div class="lower-card">
        <h3 style="color:#dc2626">⚠ 风险预警</h3>
        <div id="alertsPanel"><p class="empty-text">暂无预警</p></div>
      </div>
    </div>

    <!-- 第四行：最近政策 + 最近竞品（双栏等分） -->
    <div class="bottom-row">
      <div class="bottom-card">
        <div class="bottom-card-header">
          <h2>最近政策法规</h2>
          <a href="/policy" class="link">查看全部 →</a>
        </div>
        <div class="bottom-card-body" id="recentPolicy"><p class="empty-text">加载中...</p></div>
      </div>
      <div class="bottom-card">
        <div class="bottom-card-header">
          <h2>最近竞品动态</h2>
          <a href="/competitor" class="link">查看全部 →</a>
        </div>
        <div class="bottom-card-body" id="recentComp"><p class="empty-text">加载中...</p></div>
      </div>
    </div>
  </main>
  <script src="/js/app.js"></script>
  <script>
  async function loadDashboardV2() {
    const data = await api('/stats');
    if (!data) return;

    // === 基本统计 ===
    document.getElementById('policyCount').textContent = data.counts.policy;
    document.getElementById('competitorCount').textContent = data.counts.competitor;
    document.getElementById('partnerCount').textContent = data.counts.partner;
    document.getElementById('briefCount').textContent = data.counts.brief;

    // 24h新增角标
    if (data.recent24h) {
      if (data.recent24h.policy > 0) { document.getElementById('policyBadge').textContent = '+' + data.recent24h.policy; document.getElementById('policyBadge').style.display = 'block'; }
      if (data.recent24h.competitor > 0) { document.getElementById('compBadge').textContent = '+' + data.recent24h.competitor; document.getElementById('compBadge').style.display = 'block'; }
      if (data.recent24h.partner > 0) { document.getElementById('partnerBadge').textContent = '+' + data.recent24h.partner; document.getElementById('partnerBadge').style.display = 'block'; }
    }

    // === 信号分布 ===
    if (data.signalDist) {
      document.getElementById('sigHigh').textContent = data.signalDist.high || 0;
      document.getElementById('sigMedium').textContent = data.signalDist.medium || 0;
      document.getElementById('sigInfo').textContent = data.signalDist.info || 0;
    }

    // 侧边栏预警角标
    if (data.signalDist && data.signalDist.high > 0) {
      const b = document.getElementById('navPolicyBadge');
      b.textContent = data.signalDist.high;
      b.style.display = 'inline-block';
    }

    // === 竞品对比柱状图 ===
    const compColors = { 'E签宝': '#ea4335', '法大大': '#1a73e8', '契约锁': '#f9ab00', '腾讯电子签': '#34a853' };
    if (data.competitorBreakdown && data.competitorBreakdown.length > 0) {
      const maxCnt = Math.max(...data.competitorBreakdown.map(c => c.cnt), 1);
      document.getElementById('compBarChart').innerHTML = data.competitorBreakdown.map(c => {
        const pct = Math.max((c.cnt / maxCnt) * 100, 5);
        const color = compColors[c.competitor_name] || '#7b61ff';
        return `<div class="bar-row">
          <div class="bar-name">${escHtml(c.competitor_name)}</div>
          <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${color}">${c.cnt}</div></div>
        </div>`;
      }).join('');
    }

    // === 伙伴对比柱状图 ===
    const partColors = ['#7b61ff', '#1a73e8', '#34a853', '#f9ab00', '#ea4335', '#00bcd4'];
    if (data.partnerBreakdown && data.partnerBreakdown.length > 0) {
      const maxP = Math.max(...data.partnerBreakdown.map(c => c.cnt), 1);
      document.getElementById('partnerBarChart').innerHTML = data.partnerBreakdown.map((c, i) => {
        const pct = Math.max((c.cnt / maxP) * 100, 5);
        return `<div class="bar-row">
          <div class="bar-name">${escHtml(c.partner_name)}</div>
          <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${partColors[i % partColors.length]}">${c.cnt}</div></div>
        </div>`;
      }).join('');
    }

    // === 7天趋势图 ===
    if (data.trend && data.trend.length > 0) {
      drawTrendChart(data.trend);
    }

    // === 预警面板 ===
    const alertsEl = document.getElementById('alertsPanel');
    if (data.alerts && data.alerts.length > 0) {
      alertsEl.innerHTML = data.alerts.map(a => `
        <div class="alert-item">
          <div class="alert-dot" style="background:#dc2626"></div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:600;line-height:1.4">${escHtml(a.title)}</div>
            <div style="font-size:12px;color:#64748b;margin-top:2px">${formatDate(a.publish_date)} · ${a.source_name || ''}</div>
          </div>
        </div>
      `).join('');
    }

    // === 最近政策 ===
    const policyEl = document.getElementById('recentPolicy');
    if (data.recentIntel && data.recentIntel.length > 0) {
      policyEl.innerHTML = data.recentIntel.map(i => `
        <div class="list-item">
          <div class="list-item-title">${severityBadge(i.severity)} ${escHtml(i.title)}</div>
          <div class="list-item-meta">
            <span>${formatDate(i.publish_date)}</span>
            <span>${i.source_name || ''}</span>
          </div>
        </div>
      `).join('');
    } else {
      policyEl.innerHTML = '<p class="empty-text">暂无数据</p>';
    }

    // === 最近竞品 ===
    const compEl = document.getElementById('recentComp');
    if (data.recentComp && data.recentComp.length > 0) {
      compEl.innerHTML = data.recentComp.map(i => `
        <div class="list-item">
          <div class="list-item-title">${categoryBadge(i.category)} <strong>[${escHtml(i.competitor_name)}]</strong> ${escHtml(i.title)}</div>
          <div class="list-item-meta"><span>${formatDate(i.publish_date)}</span></div>
        </div>
      `).join('');
    } else {
      compEl.innerHTML = '<p class="empty-text">暂无数据</p>';
    }
  }

  function drawTrendChart(trend) {
    const canvas = document.getElementById('trendCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.parentElement.clientWidth - 48;
    const H = 160;
    canvas.width = W;
    canvas.height = H;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';

    const maxVal = Math.max(...trend.map(t => t.cnt), 1);
    const pad = { l: 40, r: 10, t: 10, b: 30 };
    const chartW = W - pad.l - pad.r;
    const chartH = H - pad.t - pad.b;

    // 背景网格
    ctx.strokeStyle = '#f1f5f9';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = pad.t + (chartH / 4) * i;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W - pad.r, y); ctx.stroke();
    }

    // 数据点
    const step = trend.length > 1 ? chartW / (trend.length - 1) : chartW;
    const points = trend.map((t, i) => ({
      x: pad.l + step * i,
      y: pad.t + chartH - (t.cnt / maxVal) * chartH,
      cnt: t.cnt,
      date: t.collect_date
    }));

    // 渐变填充
    const grad = ctx.createLinearGradient(0, pad.t, 0, H - pad.b);
    grad.addColorStop(0, 'rgba(79,70,229,0.2)');
    grad.addColorStop(1, 'rgba(79,70,229,0.01)');
    ctx.beginPath();
    ctx.moveTo(points[0].x, H - pad.b);
    points.forEach(p => ctx.lineTo(p.x, p.y));
    ctx.lineTo(points[points.length-1].x, H - pad.b);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();

    // 折线
    ctx.beginPath();
    ctx.strokeStyle = '#4f46e5';
    ctx.lineWidth = 2.5;
    ctx.lineJoin = 'round';
    points.forEach((p, i) => i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
    ctx.stroke();

    // 数据圆点
    points.forEach(p => {
      ctx.beginPath();
      ctx.arc(p.x, p.y, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#4f46e5';
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 2;
      ctx.stroke();
    });

    // X轴日期
    ctx.fillStyle = '#94a3b8';
    ctx.font = '11px sans-serif';
    ctx.textAlign = 'center';
    points.forEach(p => {
      ctx.fillText(p.date ? p.date.slice(5) : '', p.x, H - 8);
    });

    // Y轴数值
    ctx.textAlign = 'right';
    ctx.fillStyle = '#94a3b8';
    for (let i = 0; i <= 4; i++) {
      const val = Math.round(maxVal * (4 - i) / 4);
      const y = pad.t + (chartH / 4) * i;
      ctx.fillText(val, pad.l - 6, y + 4);
    }

    // 数值标签
    ctx.fillStyle = '#4f46e5';
    ctx.font = 'bold 11px sans-serif';
    ctx.textAlign = 'center';
    points.forEach(p => {
      if (p.cnt > 0) ctx.fillText(p.cnt, p.x, p.y - 8);
    });
  }

  function escHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  loadDashboardV2();
  </script>
</body>
</html>
